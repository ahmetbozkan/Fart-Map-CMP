{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(sed -n *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(mkdir -p *)",
      "Bash(sleep *)",
      "Bash(date*)",
      "Bash(export JAVA_HOME=*)",
      "Bash(JAVA_HOME=* ./gradlew *)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npm --prefix *)",
      "Bash(npx tsc*)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(git push *)",
      "Bash(git checkout -- *)",
      "Bash(git stash*)",
      "Bash(git merge origin/main*)",
      "Bash(git config --get *)",
      "Bash(gh pr create *)",
      "Bash(gh run *)",
      "Bash(gh label list*)",
      "Edit(.autopilot/**)",
      "Write(.autopilot/**)"
    ],
    "deny": [
      "Bash(firebase deploy*)",
      "Bash(npx firebase deploy*)",
      "Bash(gcloud *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --delete*)",
      "Bash(git push origin --delete*)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
