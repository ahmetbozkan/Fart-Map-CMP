TEAM_ID=

PRODUCT_NAME=Fart Map
PRODUCT_BUNDLE_IDENTIFIER=com.ahmetbozkan.fartmap

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
// Kotlin/Native cannot infer the framework build type from the custom configuration names (TASK-01-01-01-04).
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Debug-dev] = debug
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Debug-prod] = debug
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Release-dev] = release
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Release-prod] = release

// The Kotlin framework is static, so the app links the system frameworks its Kotlin code uses (MapKit: the map
// host, STORY-01-03-02). The target's `$(inherited) -ObjC` picks this up.
OTHER_LDFLAGS = $(inherited) -framework MapKit
