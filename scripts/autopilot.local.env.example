# Copy to scripts/autopilot.local.env (gitignored); scripts/autopilot.sh loads it on start.

# Phone notifications through ntfy (free, no account): install the ntfy app, subscribe to a topic name that
# is hard to guess (anyone who knows the name can read it), and put the same name here. Messages contain
# story ids, PR and issue numbers and one-line summaries, never code or secrets.
AUTOPILOT_NTFY_TOPIC=
# AUTOPILOT_NTFY_SERVER=https://ntfy.sh

# Or any other command; the message is in $AUTOPILOT_MESSAGE.
# AUTOPILOT_NOTIFY_CMD='curl -s -d "$AUTOPILOT_MESSAGE" https://example.com/hook'
